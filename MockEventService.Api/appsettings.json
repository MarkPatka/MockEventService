{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "event-service-consumer",
    "ProduceEventsTopic": "event-service-events",
    "ConsumeEventsTopics": [
      "user-service-events"
    ],
    "AutoOffsetReset": "Earliest",
    "DeadLetterTopic": "event-service-events-dlq",
    "MaxRetryAttempts": 3,
    "RetryDelayMs":  1000
  },
  "ApiSettings": {
    "Port": 5000,
    "CorsOrigins": []
  },
  "PgAdminSettings": {
    "DefaultEmail": "",
    "DefaultPassword": "",
    "Port": 5050
  }
}
